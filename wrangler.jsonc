{
  "name": "zenshin-clan-live",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "GAINS",
      "id": "cd3e22e2360440779a490bfea85d724e"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}